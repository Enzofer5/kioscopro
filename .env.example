# =====================================================================
# KioscoPro - Configuración. Copiá este archivo como ".env" y completalo.
# NUNCA subas el archivo .env a un repositorio.
# =====================================================================

# development | production
APP_ENV=development

# Clave secreta para firmar sesiones. Generá una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# --- Base de datos MySQL -------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kiosco_db
DB_USER=kiosco
DB_PASSWORD=cambiar

# Modo demo sin MySQL (SQLite). Si esta línea está activa, tiene prioridad sobre DB_*:
# DATABASE_URL=sqlite:///instance/kiosco_demo.db

# --- Datos del negocio (aparecen en el comprobante) ----------------------
NEGOCIO_NOMBRE=Mi Kiosco
NEGOCIO_DIRECCION=Av. Siempreviva 742, CABA
NEGOCIO_CUIT=
NEGOCIO_TELEFONO=
ZONA_HORARIA=America/Argentina/Buenos_Aires

# Exigir caja abierta para vender (recomendado: 1)
REQUIERE_CAJA_ABIERTA=1
POR_PAGINA=25

# --- Servidor ------------------------------------------------------------
# 0.0.0.0 permite entrar desde el celular en la misma red Wi-Fi
HOST=127.0.0.1
PORT=5050
# Poner en 1 cuando se sirve por HTTPS (producción)
SESSION_COOKIE_SECURE=0
# Poner en 1 si la app está detrás de Nginx/Apache/Cloudflare
BEHIND_PROXY=0
SESSION_HOURS=12

# --- Seguridad de login --------------------------------------------------
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=10

# --- Correo para recuperar contraseñas (opcional) --------------------------
# Sin SMTP, el enlace de recuperación se escribe en la consola del servidor
# y el dueño/administrador puede generar una contraseña temporal desde Usuarios.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# URL pública de la app, usada en los enlaces de los correos
APP_URL=http://127.0.0.1:5050
